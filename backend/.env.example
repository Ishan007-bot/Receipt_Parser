# Copy this file to ".env" and fill in your real key(s).
# Get a free Gemini API key at https://aistudio.google.com/apikey

# Simplest: one key.
GEMINI_API_KEY=your_key_here

# Optional: provide several keys to rotate on rate limits (429).
# All on ONE line, comma-separated, no spaces or quotes.
# If set, this takes priority over GEMINI_API_KEY.
# GEMINI_API_KEYS=key1,key2,key3

PORT=3001
